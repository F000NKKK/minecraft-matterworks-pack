			hide_dependency_lines: false
			id: "2250000000000003"
			title: "Attach Existing Storage"
			description: ["A Storage Bus exposes an external inventory to the ME network instead of moving everything into cells. This is often the cleanest way to integrate existing process buffers and machine inventories."]
			x: 5.0d
			y: -1.25d
			tasks: [{ id: "3250000000000003", item: "ae2:storage_bus", type: "item" }]
