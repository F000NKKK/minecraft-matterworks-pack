			hide_dependency_lines: false
			id: "2250000000000004"
			title: "Move Items Deliberately"
			description: ["Import and Export Buses automate direction: import pulls into ME storage, export pushes selected contents outward. Use filters and direction intentionally instead of treating the ME network as a magical shared chest."]
			x: 5.0d
			y: 1.25d
