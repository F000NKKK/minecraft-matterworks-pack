			title: "Configure the Machine Faces"
			description: ["Mekanism machines have configurable sides for items, fluids, chemicals and energy. Build a Configurator and use it deliberately: many apparent automation failures are simply input/output faces configured for the wrong resource type."]
			x: 0.0d
			y: 0.0d
			shape: "gear"
			size: 1.2d
			tasks: [{ id: "5120000000000001", item: "mekanism:configurator", type: "item" }]
			rewards: [{ id: "6220000000000001", type: "xp", xp: 25 }]
		}
		{
			dependencies: ["4120000000000001"]
			hide_dependency_lines: false
			id: "4120000000000002"
			title: "Move Electrical Power"
			description: ["Universal Cables form Mekanism's FE network. Build a short cable run and pay attention to throughput: generating enough energy is different from having enough transfer capacity to deliver it to machines."]
			x: 2.5d
			y: -1.5d
			tasks: [{ id: "5120000000000002", item: "mekanism:basic_universal_cable", count: 8, type: "item" }]
			rewards: [{ id: "6220000000000002", type: "xp", xp: 40 }]
		}
		{
			dependencies: ["4120000000000001"]
			hide_dependency_lines: false
			id: "4120000000000003"
			title: "Move Items"
			description: ["Logistical Transporters move items independently of energy cables. Treat power, items, fluids and chemicals as separate transport domains; a single visible connection does not mean every resource can travel through it."]
			x: 2.5d
			y: 0.0d
			tasks: [{ id: "5120000000000003", item: "mekanism:basic_logistical_transporter", count: 8, type: "item" }]
			rewards: [{ id: "6220000000000003", type: "xp", xp: 40 }]
		}
		{
			dependencies: ["4120000000000001"]
			hide_dependency_lines: false
			id: "4120000000000004"
			title: "Move Chemicals"
			description: ["Pressurized Tubes carry Mekanism chemicals. Gas and chemical inventory is not an item stack and cannot be routed through ordinary transporters; learn this distinction before Phase 3 starts depending on chemical process chains."]
			x: 2.5d
			y: 1.5d
			tasks: [{ id: "5120000000000004", item: "mekanism:basic_pressurized_tube", count: 8, type: "item" }]
			rewards: [{ id: "6220000000000004", type: "xp", xp: 50 }]
		}
		{
			dependencies: ["4120000000000002", "4120000000000003", "4120000000000004"]
			hide_dependency_lines: false
			id: "4120000000000005"
			title: "Inspect and Recover Process Contents"
			description: ["The Gauge Dropper lets you inspect or remove stored fluids and chemicals from compatible machines. Keep one near chemical lines: it is a practical debugging tool when a recipe stalls because the wrong substance occupies an internal tank."]
			x: 5.5d
			y: 0.0d
