			id: "4190000000000001"
			title: "Temperature Changes the Process"
			description: ["A chemical formula says which elements are present; it does not describe melting range, atmosphere, phase transitions or heat treatment. High-temperature metallurgy is therefore a process discipline, not a larger version of ordinary crafting."]
			x: 0.0d
			y: 0.0d
			shape: "gear"
			size: 1.2d
			tasks: [{ id: "5190000000000001", type: "checkmark" }]
			rewards: [{ id: "6290000000000001", type: "xp", xp: 25 }]
		}
		{
			dependencies: ["4190000000000001"]
			hide_dependency_lines: false
			id: "4190000000000002"
			title: "Alloys Need Controlled Composition"
			description: ["Industrial alloys are not defined by two arbitrary ingredients touching each other. Ratio, impurities and processing route matter. That is why Matterworks does not accept shortcuts such as iron + chromium pretending to be nichrome, or a generic molten recipe standing in for stainless-steel production."]
			x: 2.5d
			y: -1.25d
			tasks: [{ id: "5190000000000002", type: "checkmark" }]
			rewards: [{ id: "6290000000000002", type: "xp", xp: 35 }]
		}
		{
			dependencies: ["4190000000000001"]
			hide_dependency_lines: false
			id: "4190000000000003"
			title: "Ceramics and Composites Are Not Metals"
			description: ["Silicon carbide and SiC-SiC ceramic-matrix composites require ceramic processing and controlled structure. They must not be folded into the same alloying abstraction used for metallic melts simply because some ingredients overlap."]
			x: 2.5d
			y: 1.25d
			tasks: [{ id: "5190000000000003", type: "checkmark" }]
			rewards: [{ id: "6290000000000003", type: "xp", xp: 35 }]
		}
		{
			dependencies: ["4190000000000002", "4190000000000003"]
			hide_dependency_lines: false
			id: "4190000000000004"
			title: "Why Molten Routes Are Quarantined"
			description: ["Several NuclearCraft Chemical Reactor recipes depend on molten Forge tags absent from this pack. Matterworks removes those recipes instead of fabricating placeholder fluids because doing so would silently activate incomplete or chemically invalid process graphs."]
			x: 5.0d
			y: 0.0d
			shape: "diamond"
			tasks: [{ id: "5190000000000004", type: "checkmark" }]
			rewards: [{ id: "6290000000000004", type: "xp", xp: 50 }]
