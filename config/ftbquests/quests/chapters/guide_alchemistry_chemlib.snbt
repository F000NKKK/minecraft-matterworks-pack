			id: "4130000000000001"
			title: "Read Chemical Identity"
			description: ["ChemLib represents elements and compounds as chemical identities rather than interchangeable crafting ingredients. Use JEI and the periodic-table tools to read formulas before attempting any synthesis. Matterworks progression assumes you understand what a formula says and, equally importantly, what it does not say about manufacturing history."]
			x: 0.0d
			y: 0.0d
			shape: "gear"
			size: 1.2d
			tasks: [{ id: "5130000000000001", type: "checkmark" }]
			rewards: [{ id: "6230000000000001", type: "xp", xp: 25 }]
		}
		{
			dependencies: ["4130000000000001"]
			hide_dependency_lines: false
			id: "4130000000000002"
			title: "Elements vs Compounds"
			description: ["An element has one atomic identity; a compound has a fixed relationship between multiple elements. When a recipe produces a compound, preserve its stoichiometry instead of treating the ingredient list as an unordered bag of elements."]
			x: 2.5d
			y: -1.25d
			tasks: [{ id: "5130000000000002", type: "checkmark" }]
			rewards: [{ id: "6230000000000002", type: "xp", xp: 35 }]
		}
		{
			dependencies: ["4130000000000002"]
			hide_dependency_lines: false
			id: "4130000000000003"
			title: "Analysis and Reconstruction Are Different"
			description: ["Decomposition answers 'what is this made of?'; reconstruction answers 'may this composition be assembled into this material?'. Matterworks deliberately separates those questions. Analysis can reveal a composition long before the corresponding industrial process is unlocked."]
			x: 5.0d
			y: -1.25d
			tasks: [{ id: "5130000000000003", type: "checkmark" }]
			rewards: [{ id: "6230000000000003", type: "xp", xp: 45 }]
		}
		{
			dependencies: ["4130000000000003"]
			hide_dependency_lines: false
			id: "4130000000000004"
			title: "Matterworks Material Policies"
			description: ["DIRECT means composition can represent the material once its research family is owned. PROCESS means a physical route matters. MANUFACTURED means structure or fabrication history matters. MIXTURE means a single molecular formula is not an adequate identity. NUCLEAR additionally preserves isotope, enrichment, irradiation and fuel-cycle provenance."]
			x: 5.0d
			y: 1.25d
			tasks: [{ id: "5130000000000004", type: "checkmark" }]
			rewards: [{ id: "6230000000000004", type: "xp", xp: 55 }]
		}
		{
			dependencies: ["4130000000000004"]
			hide_dependency_lines: false
			id: "4130000000000005"
			title: "Atomic Operations Are Late Research"
			description: ["Breaking or constructing atomic nuclei is not ordinary chemistry. Fission and fusion chambers therefore belong to Phases 7 and 8 after NuclearCraft accelerator research. The guide explains the boundary here; the Main Program is where those machines are actually built."]
			x: 7.5d
			y: 0.0d
