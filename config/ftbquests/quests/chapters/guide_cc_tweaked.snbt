	quests: [
		{
			id: "2260000000000001"
			title: "Your First Controller"
			description: ["Build a normal computer and use the Lua prompt before automating anything. Learn the basic loop: read state, decide, act. `redstone.getInput(side)` reads a signal and `redstone.setOutput(side, value)` changes one. A useful plant controller is just this loop applied to real process state."]
			x: 0.0d
			y: 0.0d
			shape: "gear"
			size: 1.2d
			tasks: [{ id: "3260000000000001", item: "computercraft:computer_normal", type: "item" }]
			rewards: [{ id: "6260000000000001", type: "xp", xp: 25 }]
		}
		{
			dependencies: ["2260000000000001"]
			hide_dependency_lines: false
			id: "2260000000000002"
			title: "Discover Peripherals"
			description: ["Wired Modems let one computer reach peripherals without placing the computer directly beside every machine. In Lua, start with `peripheral.getNames()` and `peripheral.getType(name)`; then use `peripheral.wrap(name)` to obtain the device API."]
			x: 2.5d
			y: -1.25d
			tasks: [{ id: "3260000000000002", item: "computercraft:wired_modem", count: 2, type: "item" }]
			rewards: [{ id: "6260000000000002", type: "xp", xp: 40 }]
		}
		{
			dependencies: ["2260000000000002"]
			hide_dependency_lines: false
			id: "2260000000000003"
			title: "Build a Plant Network"
			description: ["Networking Cable joins wired modems into one peripheral network. Give attached peripherals stable names and treat those names as your control contract; automation becomes much easier to maintain when programs do not depend on physical adjacency."]
			x: 5.0d
			y: -1.25d
			tasks: [{ id: "3260000000000003", item: "computercraft:cable", count: 8, type: "item" }]
			rewards: [{ id: "6260000000000003", type: "xp", xp: 50 }]
		}
		{
			dependencies: ["2260000000000001"]
			hide_dependency_lines: false
			id: "2260000000000004"
			title: "Expose Process State"
			description: ["A monitor is useful for operator-visible state: pressure, energy, alarms, machine mode or production rate. Do not make the UI the control logic; let the program maintain state and render only the information an operator needs to diagnose the plant."]
			x: 2.5d
			y: 1.25d
			tasks: [{ id: "3260000000000004", item: "computercraft:monitor_normal", count: 2, type: "item" }]
			rewards: [{ id: "6260000000000004", type: "xp", xp: 40 }]
		}
		{
			dependencies: ["2260000000000003", "2260000000000004"]
			hide_dependency_lines: false
			id: "2260000000000005"
			title: "Event-Driven Control"
			description: ["CC:Tweaked programs should normally wait for events instead of busy-looping. `os.pullEvent()` lets one controller react to timers, redstone changes and peripheral events. Use timers for polling slow process state and reserve immediate reactions for alarms and interlocks."]
			x: 7.5d
			y: 0.0d
			shape: "diamond"
			tasks: [{ id: "3260000000000005", item: "computercraft:redstone_relay", type: "item" }]
			rewards: [{ id: "6260000000000005", type: "xp", xp: 75 }]
		}
		{
			dependencies: ["2260000000000005", "2140000000000008"]
			hide_dependency_lines: false
			id: "2260000000000006"
			title: "Capture Process State as Experience"
			description: ["After Atomic digital control is established, build PneumaticCraft's rewritten Memory Stick and extract Memory Essence from player experience. Matterworks treats this fluid as process-owned information/experience: it is captured by PneumaticCraft hardware, never reconstructed from chemical elements. The Aerial Interface is the later stationary upgrade of the same process."]
			x: 10.5d
			y: 0.0d
			shape: "hexagon"
			tasks: [
				{ id: "3260000000000006", item: "pneumaticcraft:memory_stick", type: "item" }
				{ id: "3260000000000007", item: "pneumaticcraft:memory_essence_bucket", type: "item" }
			]
			rewards: [{ id: "6260000000000006", type: "xp", xp: 125 }]
		}
	]
	title: "Guide - CC:Tweaked Process Control"
