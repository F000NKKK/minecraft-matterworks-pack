			title: "Generate Rotation with Water"
			description: ["Start by creating a real source of rotational power. Build both Water Wheel sizes and compare their footprints. A transmission network is easier to understand when it begins from a visible source of rotation rather than from disconnected gearing."]
			x: 0.0d
			y: 0.0d
			shape: "gear"
			size: 1.2d
			tasks: [
				{ id: "5110000000000001", item: "create:water_wheel", type: "item" }
				{ id: "5110000000000010", item: "create:large_water_wheel", type: "item" }
			]
			rewards: [{ id: "6210000000000002", type: "xp", xp: 40 }]
		}
		{
			dependencies: ["4110000000000002"]
			hide_dependency_lines: false
			id: "4110000000000001"
			title: "Transmit Rotation"
			description: ["Now route the generated rotation with shafts and cogwheels. Shafts carry rotation along an axis, cogwheels transfer it, and differently sized cogwheels change RPM. Build the transmission vocabulary around the working water-powered source."]
			x: 2.75d
			y: 0.0d
			shape: "gear"
			size: 1.2d
			tasks: [
				{ id: "5110000000000002", item: "create:shaft", count: 8, type: "item" }
				{ id: "5110000000000003", item: "create:cogwheel", count: 4, type: "item" }
				{ id: "5110000000000004", item: "create:large_cogwheel", count: 2, type: "item" }
			]
			rewards: [{ id: "6210000000000001", type: "xp", xp: 25 }]
		}
		{
			dependencies: ["4110000000000001"]
			hide_dependency_lines: false
			id: "4110000000000003"
			title: "Measure the Network"
			description: ["Do not diagnose Create by guessing. A Speedometer shows RPM and a Stressometer shows how much rotational capacity is being consumed. Install both on the water-powered transmission network and observe what changes when gearing or load changes."]
			x: 5.5d
			y: 0.0d
			tasks: [
				{ id: "5110000000000005", item: "create:speedometer", type: "item" }
				{ id: "5110000000000006", item: "create:stressometer", type: "item" }
			]
			rewards: [{ id: "6210000000000003", type: "xp", xp: 50 }]
		}
		{
			dependencies: ["4110000000000003"]
			hide_dependency_lines: false
			id: "4110000000000004"
			title: "Basin Processing"
			description: ["A Basin is a process vessel and a Mechanical Mixer performs operations above it. Connect them to the measured network and learn to read JEI for required Create operations, heat conditions and input handling instead of assuming every recipe belongs in a crafting grid."]
			x: 8.25d
			y: -1.25d
			tasks: [
				{ id: "5110000000000007", item: "create:basin", type: "item" }
				{ id: "5110000000000008", item: "create:mechanical_mixer", type: "item" }
			]
			rewards: [{ id: "6210000000000004", type: "xp", xp: 50 }]
		}
		{
			dependencies: ["4110000000000003"]
			hide_dependency_lines: false
			id: "4110000000000005"
			title: "Automated Assembly"
			description: ["A Deployer applies items or actions to moving workpieces and is central to sequenced assembly. Build one as the second branch from your measured rotational network; Matterworks uses this style of manufacturing for components that should require an actual production line."]
			x: 8.25d
			y: 1.25d
