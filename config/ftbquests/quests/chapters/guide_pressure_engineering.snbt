		}
		{
			dependencies: ["2270000000000001"]
			hide_dependency_lines: false
			id: "2270000000000002"
			title: "Measure Before Tuning"
			description: ["Attach a Pressure Gauge and watch the network while machines start and stop. A compressor may be healthy while a distant machine starves because demand, volume and tube restrictions cause the operating pressure to collapse under load."]
			x: 2.5d
			y: -1.25d
			tasks: [{ id: "3270000000000002", item: "pneumaticcraft:pressure_gauge", type: "item" }]
			rewards: [{ id: "6270000000000002", type: "xp", xp: 40 }]
		}
		{
			dependencies: ["2270000000000002"]
			hide_dependency_lines: false
			id: "2270000000000003"
			title: "Protect the Network"
			description: ["A Safety Tube Module vents pressure above its configured threshold. Use it as a real engineering control, not decoration: set the threshold below the weakest component's failure pressure and place protection where pressure is actually generated."]
			x: 5.0d
			y: -1.25d
			tasks: [{ id: "3270000000000003", item: "pneumaticcraft:safety_tube_module", type: "item" }]
			rewards: [{ id: "6270000000000003", type: "xp", xp: 50 }]
		}
		{
			dependencies: ["2270000000000002"]
			hide_dependency_lines: false
			id: "2270000000000004"
			title: "Read Pressure as a Signal"
			description: ["A Pressure Gauge Tube Module converts pressure into a redstone-readable control signal. This is the bridge from pneumatic physics to automation: compressors, valves and alarms can react to measured pressure rather than running continuously."]
			x: 5.0d
			y: 1.25d
			tasks: [{ id: "3270000000000004", item: "pneumaticcraft:pressure_gauge_module", type: "item" }]
			rewards: [{ id: "6270000000000004", type: "xp", xp: 50 }]
		}
