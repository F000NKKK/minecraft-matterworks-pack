	quest_links: []
	quests: [
		{ dependencies: ["2130000000000007"], hide_dependency_lines: false, id: "2140000000000001", title: "Network Foundation", description: ["Establish the first Applied Energistics network components. Atomic-scale industry begins with reliable storage, power and addressing before the network becomes a factory-wide control layer."], x: 0.0d, y: 0.0d, shape: "gear", size: 1.3d, tasks: [{ id: "3140000000000001", item: "ae2:energy_acceptor", type: "item" }], rewards: [{ id: "6140000000000001", type: "xp", xp: 175 }] }
		{ dependencies: ["2140000000000001"], hide_dependency_lines: false, id: "2140000000000002", title: "Digital Storage", description: ["Build an ME Drive and move plant inventory into an addressable storage fabric. Storage capacity alone is not automation, but it is the substrate later logistics depends on."], x: -3.5d, y: 4.0d, shape: "square", tasks: [{ id: "3140000000000002", item: "ae2:drive", type: "item" }], rewards: [{ id: "6140000000000002", type: "xp", xp: 150 }] }
		{ dependencies: ["2140000000000001"], hide_dependency_lines: false, id: "2140000000000003", title: "Networked Industry", description: ["Establish an ME Controller. Matterworks now treats logistics as shared plant infrastructure instead of a collection of independent inventories."], x: 3.5d, y: 4.0d, shape: "square", tasks: [{ id: "3140000000000003", item: "ae2:controller", type: "item" }], rewards: [{ id: "6140000000000003", type: "xp", xp: 225 }] }
		{ dependencies: ["2140000000000002"], hide_dependency_lines: false, id: "2140000000000004", title: "Operator Interface", description: ["Build a Crafting Terminal and expose the storage fabric through a controlled operator interface. This is the point where the network becomes a usable industrial service."], x: -3.5d, y: 8.0d, shape: "square", tasks: [{ id: "3140000000000004", item: "ae2:crafting_terminal", type: "item" }], rewards: [{ id: "6140000000000004", type: "xp", xp: 150 }] }
		{ dependencies: ["2140000000000003"], hide_dependency_lines: false, id: "2140000000000005", title: "Programmable Control", description: ["Introduce an advanced programmable computer into the factory. High-energy and safety-critical processes now embed programmable control hardware in their controller recipes rather than treating computation as optional quest-book prose."], x: 3.5d, y: 8.0d, shape: "square", tasks: [{ id: "3140000000000005", item: "computercraft:computer_advanced", type: "item" }], rewards: [{ id: "6140000000000005", type: "xp", xp: 200 }] }
		{ dependencies: ["2140000000000004"], hide_dependency_lines: false, id: "2140000000000006", title: "Automated Fabrication", description: ["Build an ME Pattern Provider and establish machine-addressable production requests. Automated fabrication belongs to the logistics lane while programmable supervision remains a separate control discipline."], x: -3.5d, y: 12.0d, shape: "square", tasks: [{ id: "3140000000000006", item: "ae2:pattern_provider", type: "item" }], rewards: [{ id: "6140000000000006", type: "xp", xp: 225 }] }
		{ dependencies: ["2140000000000003", "2140000000000005"], hide_dependency_lines: false, id: "2140000000000007", title: "Machine Supervision", description: ["Connect programmable control to the Applied Energistics plant through an Advanced Peripherals ME Bridge. The supervisor can now observe logistics state and becomes a physical prerequisite of accelerator control hardware."], x: 3.5d, y: 12.0d, shape: "square", tasks: [{ id: "3140000000000007", item: "advancedperipherals:me_bridge", type: "item" }], rewards: [{ id: "6140000000000007", type: "xp", xp: 225 }] }
		{ dependencies: ["2140000000000006", "2140000000000007"], hide_dependency_lines: false, id: "2140000000000008", title: "Digital Process Control", description: ["Combine the completed logistics and supervision lanes. A Molecular Assembler proves the network can store, request, fabricate and supervise production as one coordinated plant service. From this point onward safety-critical controllers may require the digital infrastructure directly."], x: 0.0d, y: 16.0d, shape: "diamond", size: 1.35d, tasks: [{ id: "3140000000000008", item: "ae2:molecular_assembler", type: "item" }], rewards: [{ id: "6140000000000008", type: "xp", xp: 450 } { id: "6140000000000009", item: "minecraft:ender_pearl", count: 3, type: "item" }] }
		{ dependencies: ["2140000000000008", "2130000000000011"], hide_dependency_lines: false, id: "2200000000000004", title: "Reinforced Glide", description: ["Reinforce an Elytra only after digital manufacturing and Industrial Age polymer engineering are both established. It remains gliding equipment rather than powered flight, but the stock HDPE upgrade is no longer a free side recipe."], x: -7.0d, y: 20.0d, shape: "gear", size: 1.2d, tasks: [{ id: "3200000000000005", item: "mekanism:hdpe_elytra", type: "item" }], rewards: [{ id: "6200000000000004", type: "xp", xp: 350 }] }

		{ dependencies: ["2140000000000008"], hide_dependency_lines: false, id: "2150000000000001", title: "Nuclear Material Processing", description: ["Enter NuclearCraft by building the Manufactory. Nuclear engineering starts with dedicated material preparation; ordinary industrial production now becomes nuclear-process infrastructure."], x: 0.0d, y: 20.0d, shape: "gear", size: 1.35d, tasks: [{ id: "3150000000000001", item: "nuclearcraft:manufactory", type: "item" }], rewards: [{ id: "6150000000000001", type: "xp", xp: 400 }] }
		{ dependencies: ["2150000000000001"], hide_dependency_lines: false, id: "2200000000000005", title: "Radiological Protection", description: ["Prepare a complete Hazmat Suit before routine uranium conversion and isotope work. Shielding is part of the operating procedure, not an optional equipment branch beside the nuclear program."], x: -7.0d, y: 24.0d, shape: "gear", size: 1.25d, tasks: [{ id: "3200000000000006", item: "mekanism:hazmat_mask", type: "item" } { id: "3200000000000007", item: "mekanism:hazmat_gown", type: "item" } { id: "3200000000000008", item: "mekanism:hazmat_pants", type: "item" } { id: "3200000000000009", item: "mekanism:hazmat_boots", type: "item" }], rewards: [{ id: "6200000000000005", type: "xp", xp: 500 }] }
		{ dependencies: ["2150000000000001", "2200000000000005"], hide_dependency_lines: false, id: "2150000000000006", title: "Uranium Feed Preparation", description: ["Follow NuclearCraft 1.2.34's actual front end: oxidise uranium in a Fluid Enricher, crystallise the uranium-oxide stream and obtain yellowcake. Matterworks removes the generic uranium-dust separator shortcut, so enrichment must begin from this prepared feed."], x: -2.5d, y: 28.0d, shape: "square", tasks: [{ id: "3150000000000006", item: "nuclearcraft:fluid_enricher", type: "item" } { id: "3150000000000007", item: "nuclearcraft:crystallizer", type: "item" } { id: "3150000000000008", item: "nuclearcraft:yellowcake_dust", count: 10, type: "item" }], rewards: [{ id: "6150000000000006", type: "xp", xp: 550 }] }
		{ dependencies: ["2150000000000001"], hide_dependency_lines: false, id: "2150000000000005", title: "Reactor Structure", description: ["Manufacture a real reactor shell before the controller. A fission reactor is a multiblock thermal system, not one magic block; prepare enough casing to begin constructing an actual machine."], x: 4.0d, y: 28.0d, shape: "square", tasks: [{ id: "3150000000000005", item: "nuclearcraft:fission_reactor_casing", count: 16, type: "item" }], rewards: [{ id: "6150000000000005", type: "xp", xp: 450 }] }
		{ dependencies: ["2150000000000006"], hide_dependency_lines: false, id: "2150000000000002", title: "Isotope Separation", description: ["Run one yellowcake enrichment batch through the Isotope Separator and recover both U-235 and U-238. Owning uranium is no longer equivalent to owning reactor-grade fuel feed."], x: -2.5d, y: 32.0d, shape: "square", tasks: [{ id: "3150000000000002", item: "nuclearcraft:isotope_separator", type: "item" } { id: "3150000000000009", item: "nuclearcraft:uranium_235", count: 2, type: "item" } { id: "3150000000000010", item: "nuclearcraft:uranium_238", count: 7, type: "item" }], rewards: [{ id: "6150000000000002", type: "xp", xp: 650 }] }
		{ dependencies: ["2150000000000005"], hide_dependency_lines: false, id: "2150000000000008", title: "Reactor Thermal Design", description: ["Build explicit heat-removal hardware before the controller. Fuel creates heat; a reactor that cannot reject that heat is not an operational power system."], x: 4.0d, y: 32.0d, shape: "square", tasks: [{ id: "3150000000000012", item: "nuclearcraft:copper_heat_sink", count: 4, type: "item" }], rewards: [{ id: "6150000000000008", type: "xp", xp: 550 }] }
		{ dependencies: ["2150000000000002"], hide_dependency_lines: false, id: "2150000000000007", title: "LEU Fuel Fabrication", description: ["Combine separated U-235 and U-238 into a low-enriched uranium fuel batch. Isotope inventory becomes reactor fuel only after an explicit fabrication step; the fuel item preserves that enrichment state as provenance."], x: -2.5d, y: 36.0d, shape: "square", tasks: [{ id: "3150000000000011", item: "nuclearcraft:fuel_uranium_leu_235", count: 3, type: "item" }], rewards: [{ id: "6150000000000007", type: "xp", xp: 650 }] }
		{ dependencies: ["2150000000000007", "2150000000000008", "2150000000000005"], hide_dependency_lines: false, id: "2150000000000004", title: "Fission Control", description: ["Construct the Fission Reactor Controller only after fabricated fuel, reactor structure and heat-removal hardware exist. Its Matterworks recipe embeds programmable and AE2 control hardware, so a safety-critical reactor controller is both a physical and digital boundary."], x: 1.0d, y: 40.0d, shape: "diamond", size: 1.35d, tasks: [{ id: "3150000000000004", item: "nuclearcraft:fission_reactor_controller", type: "item" }], rewards: [{ id: "6150000000000004", type: "xp", xp: 750 }] }
		{ dependencies: ["2150000000000004"], hide_dependency_lines: false, id: "2150000000000003", title: "Fuel Handling", description: ["Add a Fission Reactor Port. The reactor now has an explicit interface for loading fabricated fuel and removing irradiated/depleted output; blocked material flow is treated as a process failure, not inventory trivia."], x: 1.0d, y: 44.0d, shape: "square", tasks: [{ id: "3150000000000003", item: "nuclearcraft:fission_reactor_port", type: "item" }], rewards: [{ id: "6150000000000003", type: "xp", xp: 700 }] }
		{ dependencies: ["2150000000000003", "2150000000000007", "2150000000000008"], hide_dependency_lines: false, id: "2150000000000009", title: "Operational Fission", description: ["Operate the reactor long enough to produce depleted LEU-235 fuel. This is the first nuclear milestone that proves actual burnup: controller ownership alone can no longer complete the fission program."], x: 1.0d, y: 48.0d, shape: "hexagon", size: 1.45d, tasks: [{ id: "3150000000000013", item: "nuclearcraft:depleted_fuel_uranium_leu_235", type: "item" }], rewards: [{ id: "6150000000000009", type: "xp", xp: 1100 }] }
		{ dependencies: ["2150000000000009", "2200000000000001"], hide_dependency_lines: false, id: "2200000000000006", title: "Armored Mobility", description: ["Upgrade Free Runners only after successful reactor operation. Protected mobility is now tied to demonstrated Atomic infrastructure rather than merely possessing control hardware."], x: -7.0d, y: 48.0d, shape: "gear", size: 1.25d, tasks: [{ id: "3200000000000010", item: "mekanism:free_runners_armored", type: "item" }], rewards: [{ id: "6200000000000006", type: "xp", xp: 500 }] }
		{ dependencies: ["2150000000000009"], hide_dependency_lines: false, id: "2150000000000010", title: "Fuel Reprocessing", description: ["Build the Fuel Reprocessor and recover plutonium from depleted LEU fuel. The fuel cycle now includes post-irradiation material handling instead of ending when fresh fuel enters the reactor."], x: 1.0d, y: 52.0d, shape: "diamond", size: 1.3d, tasks: [{ id: "3150000000000014", item: "nuclearcraft:fuel_reprocessor", type: "item" } { id: "3150000000000015", item: "nuclearcraft:plutonium_239", type: "item" }], rewards: [{ id: "6150000000000010", type: "xp", xp: 1200 }] }
		{ dependencies: ["2150000000000010", "2200000000000003", "2200000000000006"], hide_dependency_lines: false, id: "2200000000000007", title: "Armored Flight", description: ["Upgrade the Jetpack only after the complete burnup/reprocessing branch is real. Protected powered flight is a late Atomic convenience backed by an operating nuclear industry, not a controller-block sidegrade."], x: -7.0d, y: 52.0d, shape: "diamond", size: 1.35d, tasks: [{ id: "3200000000000011", item: "mekanism:jetpack_armored", type: "item" }], rewards: [{ id: "6200000000000007", type: "xp", xp: 650 }] }

		{ dependencies: ["2150000000000010"], hide_dependency_lines: false, id: "2160000000000001", title: "Magnetic Field Hardware", description: ["Manufacture Matterworks particle-focusing coils only after the complete fission fuel cycle is demonstrated. Particle research begins with hardware that bends and confines charged beams, not with a finished accelerator controller."], x: 1.0d, y: 56.0d, shape: "gear", size: 1.35d, tasks: [{ id: "3160000000000001", item: "kubejs:particle_focusing_coil", count: 4, type: "item" }], rewards: [{ id: "6160000000000001", type: "xp", xp: 400 }] }
		{ dependencies: ["2160000000000001"], hide_dependency_lines: false, id: "2160000000000002", title: "Accelerator Vacuum Structure", description: ["Build accelerator casing. The casing represents the controlled beam environment and structural envelope required before source or transport hardware is meaningful."], x: 1.0d, y: 60.0d, shape: "square", tasks: [{ id: "3160000000000002", item: "nuclearcraft:accelerator_casing", count: 16, type: "item" }], rewards: [{ id: "6160000000000002", type: "xp", xp: 450 }] }
		{ dependencies: ["2160000000000002"], hide_dependency_lines: false, id: "2160000000000003", title: "Ion Injection", description: ["Construct the ion-source port. This is the beam origin: matter must be ionised and injected before focusing or downstream experiments can occur."], x: -2.0d, y: 64.0d, shape: "square", tasks: [{ id: "3160000000000003", item: "nuclearcraft:accelerator_ion_source_port", type: "item" }], rewards: [{ id: "6160000000000003", type: "xp", xp: 500 }] }
		{ dependencies: ["2160000000000002"], hide_dependency_lines: false, id: "2160000000000004", title: "Beam Extraction", description: ["Construct the beam port. The source creates a beam; the beam port gives that beam a controlled interface to experiments and downstream particle systems."], x: 4.0d, y: 64.0d, shape: "square", tasks: [{ id: "3160000000000004", item: "nuclearcraft:accelerator_beam_port", type: "item" }], rewards: [{ id: "6160000000000004", type: "xp", xp: 500 }] }
		{ dependencies: ["2160000000000003", "2160000000000004"], hide_dependency_lines: false, id: "2160000000000006", title: "Accelerator Interface", description: ["Add the accelerator port that integrates the multiblock with its external process infrastructure. Injection, extraction and machine interfaces are now all present."], x: 1.0d, y: 68.0d, shape: "diamond", size: 1.25d, tasks: [{ id: "3160000000000006", item: "nuclearcraft:accelerator_port", type: "item" }], rewards: [{ id: "6160000000000006", type: "xp", xp: 650 }] }
		{ dependencies: ["2160000000000006"], hide_dependency_lines: false, id: "2160000000000005", title: "Ring Accelerator", description: ["Construct the Ring Accelerator Controller after the beam hardware is complete. Its Matterworks recipe consumes the ME Bridge itself, so accelerator control is physically coupled to the earlier programmable supervision program rather than merely being adjacent to it in the quest graph."], x: 1.0d, y: 72.0d, shape: "hexagon", size: 1.5d, tasks: [{ id: "3160000000000005", item: "nuclearcraft:ring_accelerator_controller", type: "item" }], rewards: [{ id: "6160000000000005", type: "xp", xp: 1100 }] }

		{ dependencies: ["2160000000000005"], hide_dependency_lines: false, id: "2170000000000001", title: "Atomic Chamber Structure", description: ["After accelerator research, construct Alchemistry reactor casing for a dedicated transmutation chamber. The accelerator provides the high-energy engineering prerequisite; the chamber provides the controlled environment for generic atomic-number transformations."], x: 1.0d, y: 76.0d, shape: "gear", size: 1.35d, tasks: [{ id: "3170000000000001", item: "alchemistry:reactor_casing", count: 16, type: "item" }], rewards: [{ id: "6170000000000001", type: "xp", xp: 700 }] }
		{ dependencies: ["2170000000000001"], hide_dependency_lines: false, id: "2170000000000003", title: "Atomic Age Established", description: ["Construct the Alchemistry Fission Chamber Controller as a nuclear-transmutation tool, not as a substitute for the completed reactor fuel cycle. Generic atomic-number transformations only become available after digital control, uranium conversion, enrichment, operational fission, reprocessing and accelerator engineering are all established."], x: 1.0d, y: 80.0d, shape: "hexagon", size: 1.6d, tasks: [{ id: "3170000000000003", item: "alchemistry:fission_chamber_controller", type: "item" }], rewards: [{ id: "6170000000000003", type: "xp", xp: 1500 }] }
	]
	title: "Age II - Atomic Age"
}
