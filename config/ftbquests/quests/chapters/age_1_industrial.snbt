		{ dependencies: ["2130000000000010"], hide_dependency_lines: false, id: "2130000000000012", title: "Atmospheric Separation", description: ["Establish pressure-swing adsorption for bulk nitrogen production using thermopneumatic hardware and molecular-sieve media."], x: 37.0d, y: 7.0d, shape: "square", tasks: [{ id: "3130000000000012", item: "pneumaticcraft:thermopneumatic_processing_plant", type: "item" } { id: "3130000000000013", item: "kubejs:molecular_sieve_charge", count: 8, type: "item" }], rewards: [{ id: "6130000000000013", type: "xp", xp: 250 }] }

		{ dependencies: ["2130000000000002"], hide_dependency_lines: false, id: "2200000000000001", title: "Powered Mobility", description: ["Build Free Runners after controlled metallurgy is established. They are useful field equipment, not endgame armour: the rewritten recipe requires stored-energy hardware, insulated wiring, infused alloy and steel."], x: 34.0d, y: -6.5d, shape: "gear", size: 1.25d, tasks: [{ id: "3200000000000001", item: "mekanism:free_runners", type: "item" }], rewards: [{ id: "6200000000000001", type: "xp", xp: 200 }] }
		{ dependencies: ["2130000000000003"], hide_dependency_lines: false, id: "2200000000000002", title: "Breathing Equipment", description: ["Build the complete Scuba system after chemical containment is available. The mask handles the interface, while the tank stores the breathable gas supply; both are rewritten around real electrical, containment and electromagnetic hardware."], x: 38.0d, y: -6.5d, shape: "gear", size: 1.25d, tasks: [{ id: "3200000000000002", item: "mekanism:scuba_mask", type: "item" } { id: "3200000000000004", item: "mekanism:scuba_tank", type: "item" }], rewards: [{ id: "6200000000000002", type: "xp", xp: 250 }] }
		{ dependencies: ["2200000000000001", "2200000000000002", "2130000000000014"], hide_dependency_lines: false, id: "2200000000000003", title: "Powered Flight", description: ["Build the Jetpack only after reaction chemistry exists. Vertical mobility is a substantial advantage, so the recipe combines chemical containment, reaction hardware, stored energy and electromagnetic components instead of the stock early route."], x: 48.0d, y: -6.5d, shape: "diamond", size: 1.4d, tasks: [{ id: "3200000000000003", item: "mekanism:jetpack", type: "item" }], rewards: [{ id: "6200000000000003", type: "xp", xp: 350 }] }

