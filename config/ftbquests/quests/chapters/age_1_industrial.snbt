		}
		{ dependencies: ["2110000000000001"], hide_dependency_lines: false, id: "2110000000000005", title: "Mechanical Forming", description: ["Build a Mechanical Press. Matterworks electrical components depend on controlled sheet forming; hand-crafted substitutes must not bypass this manufacturing step."], x: 2.75d, y: 0.0d, shape: "square", tasks: [{ id: "3110000000000005", item: "create:mechanical_press", type: "item" }], rewards: [{ id: "6110000000000011", type: "xp", xp: 75 }] }
		{ dependencies: ["2110000000000005"], hide_dependency_lines: false, id: "2110000000000006", title: "Primitive Insulation", description: ["Manufacture insulated copper wire using the Matterworks sequenced-assembly route. Early insulation is deliberately primitive and process-made rather than a generic copper crafting recipe."], x: 5.5d, y: -2.25d, shape: "square", tasks: [{ id: "3110000000000006", item: "kubejs:insulated_copper_wire", type: "item" }], rewards: [{ id: "6110000000000012", type: "xp", xp: 100 } { id: "6110000000000013", item: "minecraft:paper", count: 8, type: "item" }] }
		{ dependencies: ["2110000000000005"], hide_dependency_lines: false, id: "2110000000000007", title: "Primitive Capacitors", description: ["Build a primitive capacitor from formed copper, dielectric material, impregnant and redstone. This is charge-storage engineering, not a free Create Crafts & Additions entry point."], x: 5.5d, y: 0.0d, shape: "square", tasks: [{ id: "3110000000000007", item: "createaddition:capacitor", type: "item" }], rewards: [{ id: "6110000000000014", type: "xp", xp: 100 } { id: "6110000000000015", item: "minecraft:redstone", count: 4, type: "item" }] }
		{ dependencies: ["2110000000000005"], hide_dependency_lines: false, id: "2110000000000002", title: "Industrial Carbon", description: ["Produce coke through the Matterworks carbon route. This branch establishes deliberate thermal carbon processing before steelmaking and engineered carbon become progression capabilities."], x: 5.5d, y: 2.25d, shape: "square", tasks: [{ id: "3110000000000002", item: "kubejs:coke", type: "item" }], rewards: [{ id: "6110000000000002", type: "xp", xp: 100 }] }
		{ dependencies: ["2110000000000006"], hide_dependency_lines: false, id: "2110000000000008", title: "Electromagnetic Components", description: ["Wind a primitive electromagnetic coil around a processed magnetic core. Coils become a reusable Matterworks component family rather than an incidental ingredient hidden inside one machine recipe."], x: 8.25d, y: -2.25d, shape: "square", tasks: [{ id: "3110000000000008", item: "kubejs:electromagnetic_coil", type: "item" }], rewards: [{ id: "6110000000000016", type: "xp", xp: 125 }] }
		{ dependencies: ["2110000000000006", "2110000000000007"], hide_dependency_lines: false, id: "2110000000000003", title: "Electromechanical Control", description: ["Assemble the first Matterworks electromechanical control unit. This is the control boundary between raw mechanical automation and machines that intentionally coordinate electrical subsystems."], x: 8.25d, y: 0.0d, shape: "diamond", size: 1.2d, tasks: [{ id: "3110000000000003", item: "kubejs:electromechanical_control_unit", type: "item" }], rewards: [{ id: "6110000000000003", type: "xp", xp: 175 }] }
		{ dependencies: ["2110000000000008", "2110000000000003", "2110000000000002"], hide_dependency_lines: false, id: "2110000000000004", title: "Mechanical Power Generation", description: ["Construct the Matterworks alternator after establishing coils, control components and industrial carbon processing. The factory can now convert kinetic work into controlled electrical power without skipping the mechanical foundation."], x: 11.25d, y: 0.0d, shape: "hexagon", size: 1.5d, tasks: [{ id: "3110000000000004", item: "createaddition:alternator", type: "item" }], rewards: [{ id: "6110000000000004", type: "xp", xp: 350 } { id: "6110000000000017", item: "create:copper_sheet", count: 4, type: "item" }] }

		{ dependencies: ["2110000000000004"], hide_dependency_lines: false, id: "2120000000000001", title: "Analytical Chemistry", description: ["Build a Dissolver. The analytical branch begins with decomposition and measurement, not synthesis: first learn to turn ordinary materials into identifiable chemical constituents."], x: 14.0d, y: 0.0d, shape: "gear", size: 1.35d, tasks: [{ id: "3120000000000001", item: "alchemistry:dissolver", type: "item" }], rewards: [{ id: "6120000000000001", type: "xp", xp: 175 }] }
		{ dependencies: ["2120000000000001"], hide_dependency_lines: false, id: "2120000000000002", title: "Elemental Sample", description: ["Recover an elemental iron sample. This establishes the simplest analytical case: one material identity mapping to one chemical element."], x: 16.75d, y: -2.0d, shape: "square", tasks: [{ id: "3120000000000002", item: "chemlib:iron", type: "item" }], rewards: [{ id: "6120000000000002", type: "xp", xp: 100 }] }
		{ dependencies: ["2120000000000002"], hide_dependency_lines: false, id: "2120000000000003", title: "Compound Analysis", description: ["Recover silicon dioxide as a compound sample. A compound is defined by a fixed elemental relationship, so analysis must preserve both identity and stoichiometry."], x: 19.5d, y: -2.0d, shape: "square", tasks: [{ id: "3120000000000003", item: "chemlib:silicon_dioxide", type: "item" }], rewards: [{ id: "6120000000000003", type: "xp", xp: 100 }] }
		{ dependencies: ["2120000000000003"], hide_dependency_lines: false, id: "2120000000000004", title: "Alloy Characterisation", description: ["Analyse brass and recover its copper and zinc constituents. This is the first deliberate distinction between chemical composition and the industrial process that created the alloy."], x: 22.25d, y: -2.0d, shape: "square", tasks: [{ id: "3120000000000004", item: "chemlib:copper", type: "item" } { id: "3120000000000008", item: "chemlib:zinc", type: "item" }], rewards: [{ id: "6120000000000004", type: "xp", xp: 150 }] }
		{ dependencies: ["2120000000000004"], hide_dependency_lines: false, id: "2120000000000006", title: "Composition Model", description: ["You have now analysed an element, a compound and an alloy. The important rule is established: knowing what something contains is not automatically permission to manufacture it by the easiest available machine."], x: 22.25d, y: 1.75d, shape: "diamond", size: 1.2d, tasks: [{ id: "3120000000000006", item: "create:brass_ingot", type: "item" }], rewards: [{ id: "6120000000000006", type: "xp", xp: 175 }] }
		{ dependencies: ["2120000000000006"], hide_dependency_lines: false, id: "2120000000000007", title: "Controlled Reconstruction", description: ["Only after completing the analytical curriculum do you build the Combiner. It reconstructs permitted material families; PROCESS, MANUFACTURED, MIXTURE and provenance-sensitive materials still belong to their physical production routes."], x: 25.0d, y: 0.0d, shape: "gear", size: 1.4d, tasks: [{ id: "3120000000000007", item: "alchemistry:combiner", type: "item" }], rewards: [{ id: "6120000000000007", type: "xp", xp: 300 }] }

		{ dependencies: ["2120000000000007"], hide_dependency_lines: false, id: "2130000000000001", title: "Controlled Metallurgy", description: ["Build the Matterworks-gated Metallurgic Infuser. This is the first controlled electrical metallurgy platform and remains rooted in the mechanical production line that created its control hardware."], x: 28.0d, y: 0.0d, shape: "gear", size: 1.35d, tasks: [{ id: "3130000000000001", item: "mekanism:metallurgic_infuser", type: "item" }], rewards: [{ id: "6130000000000001", type: "xp", xp: 225 }] }
		{ dependencies: ["2130000000000001"], hide_dependency_lines: false, id: "2130000000000003", title: "Gas Containment", description: ["Build chemical storage before generating industrial process gases. Gas production without dedicated containment is not an acceptable process capability."], x: 31.0d, y: -4.0d, shape: "square", tasks: [{ id: "3130000000000003", item: "mekanism:basic_chemical_tank", type: "item" }], rewards: [{ id: "6130000000000003", type: "xp", xp: 125 }] }
		{ dependencies: ["2130000000000001"], hide_dependency_lines: false, id: "2130000000000002", title: "Infused Materials", description: ["Produce infused alloy through the controlled metallurgical route. This proves the plant can execute repeatable material infusion instead of merely owning the machine block."], x: 31.0d, y: -1.25d, shape: "square", tasks: [{ id: "3130000000000002", item: "mekanism:alloy_infused", count: 4, type: "item" }], rewards: [{ id: "6130000000000002", type: "xp", xp: 125 }] }
		{ dependencies: ["2130000000000002"], hide_dependency_lines: false, id: "2130000000000013", title: "Electrical Furnace", description: ["Build an Energized Smelter before attempting industrial graphitization. Matterworks uses this machine as the current electrical-furnace abstraction for high-temperature carbon processing."], x: 34.0d, y: 1.5d, shape: "gear", tasks: [{ id: "3130000000000014", item: "mekanism:energized_smelter", type: "item" }], rewards: [{ id: "6130000000000014", type: "xp", xp: 150 }] }
		{ dependencies: ["2130000000000013"], hide_dependency_lines: false, id: "2130000000000006", title: "Engineered Carbon Production", description: ["Use the electrical furnace to graphitize coke and produce graphite. Graphite is now a real process output and becomes the electrode feed for the first industrial electrolysis stack."], x: 37.0d, y: 1.5d, shape: "square", tasks: [{ id: "3130000000000006", item: "kubejs:graphite", count: 4, type: "item" }], rewards: [{ id: "6130000000000006", type: "xp", xp: 150 }] }
		{ dependencies: ["2130000000000002", "2130000000000003", "2130000000000006"], hide_dependency_lines: false, id: "2130000000000004", title: "Electrochemical Core", description: ["Construct the graphite-electrode electrochemical core only after infused alloy, gas-handling hardware and engineered graphite are available."], x: 40.0d, y: -2.0d, shape: "diamond", tasks: [{ id: "3130000000000004", item: "mekanism:electrolytic_core", type: "item" }], rewards: [{ id: "6130000000000004", type: "xp", xp: 175 }] }
		{ dependencies: ["2130000000000004"], hide_dependency_lines: false, id: "2130000000000005", title: "Industrial Electrolysis", description: ["Build an Electrolytic Separator around the electrochemical core. The separator supplies hydrogen and oxygen for later reaction chemistry."], x: 43.0d, y: -2.0d, shape: "gear", size: 1.2d, tasks: [{ id: "3130000000000005", item: "mekanism:electrolytic_separator", type: "item" }], rewards: [{ id: "6130000000000005", type: "xp", xp: 225 }] }
		{ dependencies: ["2130000000000005"], hide_dependency_lines: false, id: "2130000000000014", title: "Reaction Chemistry", description: ["Build a Pressurized Reaction Chamber. The PRC combines item, fluid and chemical feeds in a controlled process vessel."], x: 46.0d, y: -2.0d, shape: "gear", tasks: [{ id: "3130000000000015", item: "mekanism:pressurized_reaction_chamber", type: "item" }], rewards: [{ id: "6130000000000015", type: "xp", xp: 225 }] }
		{ dependencies: ["2130000000000014"], hide_dependency_lines: false, id: "2130000000000015", title: "Polymer Feedstock", description: ["Run the first PRC stage with water, hydrogen and biofuel. It produces substrate and chemical ethene; both outputs matter to the next stage."], x: 49.0d, y: -2.0d, shape: "square", tasks: [{ id: "3130000000000016", item: "mekanism:substrate", count: 4, type: "item" }], rewards: [{ id: "6130000000000016", type: "xp", xp: 200 }] }
		{ dependencies: ["2130000000000015"], hide_dependency_lines: false, id: "2130000000000016", title: "Ethene Phase Conversion", description: ["The first PRC outputs ethene as a Mekanism chemical, while HDPE polymerization consumes liquid ethene. Build a Rotary Condensentrator and convert the chemical stream into its fluid phase."], x: 52.0d, y: -2.0d, shape: "square", tasks: [{ id: "3130000000000017", item: "mekanism:rotary_condensentrator", type: "item" }], rewards: [{ id: "6130000000000017", type: "xp", xp: 225 }] }
