		{ dependencies: ["2130000000000002"], hide_dependency_lines: false, id: "2130000000000008", title: "Electromechanical Power Conversion", description: ["Build the Matterworks-gated Electric Motor after controlled metallurgy has produced both steel and Mekanism control electronics."], x: 37.0d, y: 4.25d, shape: "square", tasks: [{ id: "3130000000000008", item: "createaddition:electric_motor", type: "item" }], rewards: [{ id: "6130000000000009", type: "xp", xp: 225 }] }
		{ dependencies: ["2130000000000001"], hide_dependency_lines: false, id: "2130000000000009", title: "Rotational Pneumatics", description: ["Bridge Create rotation into pneumatic pressure with the Matterworks-gated Rotational Compressor."], x: 31.0d, y: 7.0d, shape: "square", tasks: [{ id: "3130000000000009", item: "compressedcreativity:rotational_compressor", type: "item" }], rewards: [{ id: "6130000000000010", type: "xp", xp: 175 }] }
