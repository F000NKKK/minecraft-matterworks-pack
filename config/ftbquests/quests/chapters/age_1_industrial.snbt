		{
			id: "2110000000000001"
			title: "Precision Manufacturing"
			description: ["Establish repeatable Create precision manufacturing. This is the first machine-building discipline of Matterworks and the foundation for every later electromechanical assembly."]
			x: 0.0d
			y: 0.0d
			shape: "gear"
			size: 1.35d
			tasks: [{ id: "3110000000000001", item: "create:precision_mechanism", type: "item" }]
