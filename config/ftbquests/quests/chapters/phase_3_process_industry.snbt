		{ dependencies: ["2120000000000007"], hide_dependency_lines: false, id: "2130000000000001", title: "Controlled Metallurgy", description: ["Build the Matterworks-gated Metallurgic Infuser. This is the first controlled electrical metallurgy platform and remains rooted in the mechanical production line that created its control hardware."], x: 0.0d, y: 0.0d, shape: "gear", size: 1.35d, tasks: [{ id: "3130000000000001", item: "mekanism:metallurgic_infuser", type: "item" }], rewards: [{ id: "6130000000000001", type: "xp", xp: 225 }] }
		{ dependencies: ["2130000000000001"], hide_dependency_lines: false, id: "2130000000000003", title: "Gas Containment", description: ["Build chemical storage before generating industrial process gases. Gas production without dedicated containment is not an acceptable process capability."], x: 3.0d, y: -4.0d, shape: "square", tasks: [{ id: "3130000000000003", item: "mekanism:basic_chemical_tank", type: "item" }], rewards: [{ id: "6130000000000003", type: "xp", xp: 125 }] }
		{ dependencies: ["2130000000000001"], hide_dependency_lines: false, id: "2130000000000002", title: "Infused Materials", description: ["Produce infused alloy through the controlled metallurgical route. This proves the plant can execute repeatable material infusion instead of merely owning the machine block."], x: 3.0d, y: -1.25d, shape: "square", tasks: [{ id: "3130000000000002", item: "mekanism:alloy_infused", count: 4, type: "item" }], rewards: [{ id: "6130000000000002", type: "xp", xp: 125 }] }
		{ dependencies: ["2130000000000002"], hide_dependency_lines: false, id: "2130000000000013", title: "Electrical Furnace", description: ["Build an Energized Smelter before attempting industrial graphitization. Matterworks uses this machine as the current electrical-furnace abstraction for high-temperature carbon processing, so graphite must not appear in the quest graph before the furnace that actually produces it."], x: 6.0d, y: 1.5d, shape: "gear", tasks: [{ id: "3130000000000014", item: "mekanism:energized_smelter", type: "item" }], rewards: [{ id: "6130000000000014", type: "xp", xp: 150 }] }
		{ dependencies: ["2130000000000013"], hide_dependency_lines: false, id: "2130000000000006", title: "Engineered Carbon Production", description: ["Use the electrical furnace to graphitize coke and produce graphite. Graphite is now a real process output and becomes the electrode feed for the first industrial electrolysis stack."], x: 9.0d, y: 1.5d, shape: "square", tasks: [{ id: "3130000000000006", item: "kubejs:graphite", count: 4, type: "item" }], rewards: [{ id: "6130000000000006", type: "xp", xp: 150 }] }
		{ dependencies: ["2130000000000002", "2130000000000003", "2130000000000006"], hide_dependency_lines: false, id: "2130000000000004", title: "Electrochemical Core", description: ["Construct the graphite-electrode electrochemical core only after infused alloy, gas-handling hardware and engineered graphite are available. The recipe physically consumes graphite electrodes, primitive wiring, a capacitor, quartz and infused alloy."], x: 12.0d, y: -2.0d, shape: "diamond", tasks: [{ id: "3130000000000004", item: "mekanism:electrolytic_core", type: "item" }], rewards: [{ id: "6130000000000004", type: "xp", xp: 175 }] }
		{ dependencies: ["2130000000000004"], hide_dependency_lines: false, id: "2130000000000005", title: "Industrial Electrolysis", description: ["Build an Electrolytic Separator around the electrochemical core. The separator supplies hydrogen and oxygen for later reaction chemistry."], x: 15.0d, y: -2.0d, shape: "gear", size: 1.2d, tasks: [{ id: "3130000000000005", item: "mekanism:electrolytic_separator", type: "item" }], rewards: [{ id: "6130000000000005", type: "xp", xp: 225 }] }
		{ dependencies: ["2130000000000005"], hide_dependency_lines: false, id: "2130000000000014", title: "Reaction Chemistry", description: ["Build a Pressurized Reaction Chamber. The PRC combines item, fluid and chemical feeds in a controlled process vessel."], x: 18.0d, y: -2.0d, shape: "gear", tasks: [{ id: "3130000000000015", item: "mekanism:pressurized_reaction_chamber", type: "item" }], rewards: [{ id: "6130000000000015", type: "xp", xp: 225 }] }
		{ dependencies: ["2130000000000014"], hide_dependency_lines: false, id: "2130000000000015", title: "Polymer Feedstock", description: ["Run the first PRC stage with water, hydrogen and biofuel. It produces substrate and chemical ethene; both outputs matter to the next stage."], x: 21.0d, y: -2.0d, shape: "square", tasks: [{ id: "3130000000000016", item: "mekanism:substrate", count: 4, type: "item" }], rewards: [{ id: "6130000000000016", type: "xp", xp: 200 }] }
		{ dependencies: ["2130000000000015"], hide_dependency_lines: false, id: "2130000000000016", title: "Ethene Phase Conversion", description: ["The first PRC outputs ethene as a Mekanism chemical, while HDPE polymerization consumes liquid ethene. Build a Rotary Condensentrator and convert the chemical stream into its fluid phase before attempting polymerization."], x: 24.0d, y: -2.0d, shape: "square", tasks: [{ id: "3130000000000017", item: "mekanism:rotary_condensentrator", type: "item" }], rewards: [{ id: "6130000000000017", type: "xp", xp: 225 }] }
		{ dependencies: ["2130000000000016"], hide_dependency_lines: false, id: "2130000000000011", title: "Polymer Engineering", description: ["Feed substrate, liquid ethene and oxygen into the PRC to produce HDPE pellets. The quest now follows the actual Mekanism process chain end to end."], x: 27.0d, y: -2.0d, shape: "diamond", tasks: [{ id: "3130000000000011", item: "mekanism:hdpe_pellet", count: 8, type: "item" }], rewards: [{ id: "6130000000000012", type: "xp", xp: 300 }] }
